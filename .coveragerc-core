# 核心目录覆盖率报告配置
# 2026-11-19：由 0（仅报告）改为 57（实测核心 10 目录 60.60% - 3.6 点缓冲），
# ci.yml 的核心目录步骤通过 COVERAGE_RCFILE=.coveragerc-core 使用本阈值。
# 长期目标：核心目录 ≥80%。
# 用法：
#   pytest --cov=scripts/common --cov=scripts/fetchers --cov=scripts/data \
#     --cov=scripts/business --cov=scripts/technical --cov=scripts/portfolio \
#     --cov=scripts/monitor --cov=scripts/backtest --cov=scripts/strategies \
#     --cov=scripts/config --cov-report=term tests/unit/
[run]
source = scripts

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    pass

fail_under = 57
show_missing = true
skip_empty = true
precision = 1
