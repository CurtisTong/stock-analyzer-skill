# Stock Analyzer Skill - 环境变量示例
# 复制为 .env 并填入真实值；缺失的变量会让对应数据源降级，但不影响主流程。
#
# v1.16.0 补全：docs/audit-2026-07-28.md §D-A 建议
# — 新增用户从这份清单能感知到所有可配置的环境变量。

# ──────────────────────────────────────────────
# 涨跌停统计（可选）
# ──────────────────────────────────────────────
# 东方财富 ut token，用于涨跌停 / 涨停池统计 / kline 数据源。
# 缺失时涨跌停数据降级（limit_up=0），情绪温度判不准但不影响主流程。
# 获取方式：浏览器登录 eastmoney.com -> DevTools -> Network ->
#           任一数据请求的 Cookie -> 复制 ut 值（形如 "xxxxxxxx"）
EASTMONEY_UT_TOKEN=

# ──────────────────────────────────────────────
# 板块股票池初始化（可选）
# ──────────────────────────────────────────────
# 东方财富 API token（与 ut token 不同），仅在 init_pool/refresh_pool
# 调用板块股票池初始化时使用。缺失时这 2 个命令降级为空结果。
EASTMONEY_API_TOKEN=

# ──────────────────────────────────────────────
# Tushare（可选）
# ──────────────────────────────────────────────
# Tushare Pro token，缺失时所有 tushare_* 数据源（quote/kline）不可用。
# 注册：https://tushare.pro/register
TUSHARE_TOKEN=

# ──────────────────────────────────────────────
# 缓存（可选）
# ──────────────────────────────────────────────
# 自定义缓存根目录（默认 ~/.cache/stock-analyzer/）
# 用法：export STOCK_CACHE_DIR=/var/tmp/stock-analyzer-cache
STOCK_CACHE_DIR=

# 缓存最大尺寸（MB），超过按 LRU 清理（默认 500）
STOCK_CACHE_MAX_SIZE_MB=500

# ──────────────────────────────────────────────
# 数据 TTL 与超时（可选）
# ──────────────────────────────────────────────
# 见 scripts/data/config.py：data_source.yaml 之外的环境变量覆盖通道。
# 单位：秒（timeout）/ 秒（TTL）
DATA_HTTP_TIMEOUT=10
DATA_PARALLEL_TIMEOUT=20
DATA_QUOTE_TTL=60
DATA_INTRADAY_QUOTE_TTL=10
DATA_KLINE_TTL=86400
DATA_KLINE_1M_TTL=60
DATA_KLINE_240M_TTL=86400
DATA_FINANCE_TTL=86400
DATA_MARGIN_TTL=86400

# ──────────────────────────────────────────────
# 熔断器阈值（可选）
# ──────────────────────────────────────────────
# 连续失败次数触发熔断（默认来自 data_source.yaml）
DATA_CIRCUIT_THRESHOLD=5
# 熔断恢复时间（默认来自 data_source.yaml）
DATA_CIRCUIT_TIMEOUT=60

# ──────────────────────────────────────────────
# 调试与任务超时（可选）
# ──────────────────────────────────────────────
# 置 1 时异常打印完整 traceback（等效各 CLI 的 --debug 参数）
STOCK_DEBUG=

# screener 整体任务超时秒数（默认 1800s，覆盖 --deadline 之外的兜底通道）
STOCK_SCREENER_DEADLINE=
