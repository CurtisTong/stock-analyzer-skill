[run]
source = scripts
# review 修复（P2）：移除 technical/sentiment.py 与 technical/report.py 的 omit。
# 它们仍被 technical.py / analyzer.py / market_breadth.py / zt_pool.py 等活跃路径引用，
# 继续 omit 会让覆盖率门禁对这两块失明。

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    pass

fail_under = 48
show_missing = true
skip_empty = true
precision = 1

# 注：2026-11-19 统一口径：门禁只有一个真相（本文件 fail_under），ci.yml 与
# release.yml 通过 test-suite.yml 的 fail-under 传入同一数值。
# 取值 = 实测覆盖率 - 3 个点的缓冲（实测 tests/unit 全仓 50.96%，取 48）。
# 调整规则：只在覆盖率真实提升后上调，且必须同步改 ci.yml / release.yml 调用方。
# 长期目标：P2-X 路线图回归 60%。
