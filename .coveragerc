[run]
source = scripts
omit =
    # 已废弃或低价值的低覆盖模块
    scripts/technical/sentiment.py
    scripts/technical/report.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    pass

fail_under = 30
show_missing = true
skip_empty = true
precision = 1

# 注：v1.16.0 重构期（commit 68f9e83）同步下调阈值至 21%（与 ci.yml 一致）。
# 长期目标：P2-X 路线图回归 60%。
