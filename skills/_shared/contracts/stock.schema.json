{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "stock.py CLI JSON 输出（v1.31 向现实收拢）",
  "description": "描述 `python3 scripts/stock.py <代码> -j` 的真实输出结构。v1.31 之前本 schema 要求 fundamental.rating/valuation.view/position_plan 等生产端从未输出的嵌套字段（LLM 只能编造）；现按实际输出收拢：五层语义由消费方（/portfolio、/research）从 finance/score/technical 现有字段推导，映射见 skills/_shared/references/five-layer.md。",
  "type": "object",
  "required": [
    "code",
    "name",
    "price",
    "change_pct",
    "data_time",
    "score",
    "technical",
    "finance"
  ],
  "additionalProperties": true,
  "properties": {
    "code": {
      "type": "string",
      "description": "归一化代码 sh600989"
    },
    "name": {
      "type": "string"
    },
    "price": {
      "type": [
        "number",
        "null"
      ],
      "description": "现价"
    },
    "change_pct": {
      "type": [
        "number",
        "null"
      ],
      "description": "今日涨跌%"
    },
    "data_time": {
      "type": "string",
      "description": "数据时间戳（页脚用）"
    },
    "data_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_failed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "降级数据源（护栏条）"
    },
    "data_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kline_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "finance": {
      "type": "object",
      "description": "财务摘要（_extract_finance_summary 输出；缺失字段为 null，eps_caliber 标注单季/年报口径）",
      "properties": {
        "roe": {
          "type": [
            "number",
            "null"
          ],
          "description": "ROE(%)，累计口径已按报告期缩放"
        },
        "eps": {
          "type": [
            "number",
            "null"
          ]
        },
        "net_profit_yoy": {
          "type": [
            "number",
            "null"
          ]
        },
        "revenue_yoy": {
          "type": [
            "number",
            "null"
          ]
        },
        "gross_margin": {
          "type": [
            "number",
            "null"
          ]
        },
        "debt_ratio": {
          "type": [
            "number",
            "null"
          ]
        },
        "period_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "annual",
            "cumulative",
            "quarterly",
            null
          ]
        },
        "report_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "eps_caliber": {
          "type": "string",
          "description": "口径标签，如 '单季 2026-03-31'；单季 EPS 不可直接算 PE"
        }
      },
      "additionalProperties": true
    },
    "technical": {
      "type": "object",
      "description": "五层分析的技术面摘要（business/stock_analysis._analyze_technical 输出）。注意：这不是 technical.py CLI 的完整报告——那份结构由 technical.schema.json 描述",
      "properties": {
        "ma": {
          "type": [
            "string",
            "null"
          ],
          "description": "均线排列定性（多头/空头/纠缠/数据不足）"
        },
        "rsi": {
          "type": [
            "number",
            "null"
          ]
        },
        "macd_signal": {
          "type": [
            "integer",
            "null"
          ],
          "description": "1 金叉 / -1 死叉 / 0 无"
        },
        "macd_divergence": {
          "type": [
            "string",
            "null"
          ],
          "description": "顶背离/底背离/空"
        },
        "macd_bar_trend": {
          "type": [
            "string",
            "null"
          ],
          "description": "红绿柱趋势（供评分层金叉+红柱放大识别）"
        },
        "kdj": {
          "type": [
            "string",
            "null"
          ],
          "description": "KDJ 信号定性"
        },
        "boll_position": {
          "type": [
            "number",
            "null"
          ],
          "description": "布林带位置 0-1"
        },
        "volume_signal": {
          "type": [
            "integer",
            "null"
          ],
          "description": "量能信号"
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "K 线形态（date/type/position）"
        },
        "bamboo": {
          "type": [
            "object",
            "null"
          ],
          "description": "竹节法（signal/status/desc/高低点）"
        },
        "ma_stop_buy": {
          "type": [
            "object",
            "null"
          ],
          "description": "均线止跌买点（signal/type/status/desc）"
        }
      },
      "additionalProperties": true
    },
    "score": {
      "type": "object",
      "required": [
        "score",
        "grade"
      ],
      "properties": {
        "score": {
          "type": "number",
          "description": "综合评分 0-100"
        },
        "grade": {
          "type": "string",
          "description": "评级档（strong_buy/buy/neutral/sell/strong_sell）"
        },
        "buy_signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sell_signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "structured_signals": {
          "type": "object",
          "description": "布尔信号字典（macd_golden_cross/kdj_overbought/volume_inflow 等，评分层输入）",
          "additionalProperties": {
            "type": "boolean"
          }
        }
      },
      "additionalProperties": true
    },
    "profile": {
      "type": "object",
      "description": "股票画像（industry/type/confidence/reasons/priority_indicators；capacity/dealer 可为 null）",
      "additionalProperties": true
    },
    "chan": {
      "type": "object",
      "description": "缠论摘要（bi_count/zhongshu_count/xianduan_count/beichi/maidian/current_position 等；error 表示分析失败）",
      "additionalProperties": true
    },
    "backtest": {
      "type": "object",
      "description": "--with-backtest 附加：{win_rate, total_return, sharpe, max_drawdown}（可能含 null）",
      "additionalProperties": true
    },
    "backtest_error": {
      "type": "string",
      "description": "--with-backtest 失败时的降级说明（与 backtest 互斥）"
    }
  }
}
